# Application Environment
APP_ENV=local
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=meris
DB_PASSWORD=password
DB_NAME=merisdb
DB_SCHEMA=public
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Configuration (9Router / OpenAI Compatible)
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=http://localhost:20128/v1/chat/completions
# 9Router model ids carry a provider prefix (ag/...); the bare name returns 404
AI_MODEL=ag/gemini-3.8-flash-low
AI_ESCALATION_MODEL=ag/gemini-3.8-flash-high

# Object Storage Configuration (RustFS / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=meris-receipts
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY=24h

# Server Configuration
PORT=8080
BIND_ADDRESS=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000

# OpenTelemetry (disabled by default in local/dev; set OTEL_ENABLED=true and endpoint to export)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Session creation limit per client IP. MAX=0 turns the limiter off; WINDOW is a Go duration (30m, 8h, 24h)
RATE_LIMIT_SESSION_MAX=5
RATE_LIMIT_SESSION_WINDOW=8h
