# ==========================================
# Meris Environment Configuration Template
# ==========================================

# Database Configuration
# You can provide DATABASE_URL (for PgBouncer) and DATABASE_DIRECT_URL (for migrations),
# or specify the individual DB_* connection parameters below.
DATABASE_URL=postgres://postgres:password@postgres:5432/merisdb?sslmode=disable
DATABASE_DIRECT_URL=postgres://postgres:password@postgres:5432/merisdb?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=merisdb
DB_SCHEMA=public
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis Configuration
# In production/homelab, REDIS_URL includes ACL user and credentials.
REDIS_URL=redis://redis:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# App Configuration
BIND_ADDRESS=0.0.0.0
PORT=8080
APP_ENV=production
ALLOWED_ORIGINS=https://meris.teukumunawark.my.id,http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=https://meris-api.teukumunawark.my.id

# AI Configuration (9Router / OpenAI Compatible)
AI_API_KEY=your-ai-api-key
AI_ENDPOINT=http://localhost:20128/v1/chat/completions
AI_MODEL=gemini-2.5-flash

# Observability Configuration (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
