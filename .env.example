# ==========================================
# Meris Environment Configuration Template
# ==========================================

# Database Configuration
# You can provide DATABASE_URL (for PgBouncer) and DATABASE_DIRECT_URL (for migrations),
# or specify the individual DB_* connection parameters below.
DATABASE_URL=postgres://postgres:password@postgres:5432/merisdb?sslmode=disable
DATABASE_DIRECT_URL=postgres://postgres:password@postgres:5432/merisdb?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=merisdb
DB_SCHEMA=public
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis Configuration
# In production/homelab, REDIS_URL includes ACL user and credentials.
REDIS_URL=redis://redis:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# App Configuration
BIND_ADDRESS=0.0.0.0
PORT=8080
APP_ENV=production
ALLOWED_ORIGINS=https://meris.munawar.my.id,http://localhost:3000
# Session creation limit per client IP (POST /session also triggers the AI call). MAX=0 turns the limiter off.
# WINDOW is a Go duration such as 30m, 8h or 24h. Both are read at start, so restart the API after changing them.
RATE_LIMIT_SESSION_MAX=5
RATE_LIMIT_SESSION_WINDOW=8h
# Build-time only. Local dev uses the API directly; the production image is built in CI with NEXT_PUBLIC_BACKEND_URL=/_api.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8091

# AI Configuration (9Router / OpenAI Compatible)
AI_API_KEY=your-ai-api-key
AI_ENDPOINT=http://localhost:20128/v1/chat/completions
# 9Router model ids carry a provider prefix (ag/...); the bare name returns 404
AI_MODEL=ag/gemini-3.8-flash-low
AI_ESCALATION_MODEL=ag/gemini-3.8-flash-high

# Observability Configuration (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
