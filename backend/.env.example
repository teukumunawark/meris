# Database Configuration
# Format: host=... user=... password=... dbname=... port=... sslmode=...
DATABASE_URL=host=localhost user=meris password=password dbname=merisdb port=5432 sslmode=disable

# AI Configuration (Xiaomi MiMo)
# Get your API key from Xiaomi MiMo dashboard
MIMO_API_KEY=your_mimo_api_key_here
MIMO_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5

# Server Configuration
PORT=8080
